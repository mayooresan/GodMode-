# Copy to .env and adjust. Every value has a working default.

# Where the dashboard is published on the host.
HOST_PORT=8080
# Use 127.0.0.1 when a reverse proxy terminates TLS in front of the engine.
BIND_ADDR=0.0.0.0

# World generation — only applied when no snapshot exists (or RESUME=false).
WORLD_WIDTH=128
WORLD_HEIGHT=128
WORLD_SEED=20260908
# The world starts fragmented into many small tribes and consolidates through
# conquest, so the surviving empires grow far larger than the founding bands.
# Give MAX_AGENTS real headroom or the world stalls against the ceiling.
STARTING_TRIBES=14
STARTING_AGENTS=8
MAX_AGENTS=15000

# Simulation pace. 1000 = one tick per second; the dashboard can change this live.
TICK_MS=1000
SNAPSHOT_EVERY_TICKS=60
RESUME=true

# REQUIRED on any internet-facing host: without it, anyone who loads the
# dashboard can trigger floods, plagues and population wipes.
ADMIN_TOKEN=

# Restrict if the dashboard is served from another origin.
CORS_ORIGIN=*

LOG_LEVEL=info
CPU_LIMIT=1.0
MEMORY_LIMIT=900M
